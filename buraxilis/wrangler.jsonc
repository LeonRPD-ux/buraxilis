{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buraxilis",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/app-release-signed.apk", "/app-release-bundle.aab", "/.well-known/assetlinks.json", "/version.json"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "SYNC", "class_name": "Sync" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Sync"] }
  ]
}
